		{
			"id": "te00245",
			"type": "text",
			"x": 4044,
			"y": 96.5,
			"width": 1615.306640625,
			"height": 22.5,
			"angle": 0,
			"strokeColor": "#f1f3f5",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [
				"g00242"
			],
			"frameId": "fr00241",
			"roundness": null,
			"seed": 1291381513,
			"version": 2,
			"versionNonce": 326515036,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794554867194,
			"link": null,
			"locked": false,
			"text": "Rotational analog of mass: I measures resistance to changes in rotational motion. It depends on the mass and on how that mass is distributed about the axis. With it, Newton's second law becomes τ = Iα.",
			"originalText": "Rotational analog of mass: I measures resistance to changes in rotational motion. It depends on the mass and on how that mass is distributed about the axis. With it, Newton's second law becomes τ = Iα.",
			"fontSize": 18,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "b2X",
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null
		},
		{
