			"updated": 1794554867195,
			"link": null,
			"locked": false,
			"text": "#61 → √(6gd sin θ/5)；#62 → 0.53 m；#63 → 24%；#64 → 5h/7；#67 →\n24 m；#68 → h = 2.7R；#72 → P = (M + 2m)va，減少 0.552% 與 0.828%",
			"originalText": "#61 → √(6gd sin θ/5)；#62 → 0.53 m；#63 → 24%；#64 → 5h/7；#67 →\n24 m；#68 → h = 2.7R；#72 → P = (M + 2m)va，減少 0.552% 與 0.828%",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
