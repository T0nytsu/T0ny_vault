		{
			"id": "te00768",
			"type": "text",
			"x": 2594,
			"y": 3717.75,
			"width": 493.5078125,
			"height": 80,
			"angle": 0,
			"strokeColor": "#d9480f",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
