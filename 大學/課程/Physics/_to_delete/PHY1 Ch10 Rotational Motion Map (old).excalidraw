			"text": "10.3  Rotational Inertia and the Analog of Newton's Law",
			"originalText": "10.3  Rotational Inertia and the Analog of Newton's Law",
			"fontSize": 34,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.25,
